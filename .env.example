# Growthpoint Knowledge Assistant — environment configuration
#
# The PoC runs in mock mode by default (no AWS needed). Copy this file to .env
# and edit only if you want to switch to a live AWS Bedrock Knowledge Base
# (Amazon S3 Vectors store + Titan Text Embeddings V2 + Claude 3 Haiku).

# Mock mode (default). Set to false to use AWS Bedrock.
USE_MOCK=true

# --- Only needed when USE_MOCK=false ---
# us-east-1 is the default: S3 Vectors + Bedrock KB are reliably available there
# (af-south-1 is not reliable for this combination).
AWS_REGION=us-east-1
# Default sandbox profile; change to your own named profile if needed.
AWS_PROFILE=abulele-ntt-sandbox
# Set after running infra/provision.py (it prints the id).
KNOWLEDGE_BASE_ID=
# Cheapest ACTIVE Claude: Haiku 4.5 (Claude 3 Haiku is EOL as of Sept 2026).
# Served via a cross-region inference profile (the "us." prefix).
LLM_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Embeddings for the S3 Vectors knowledge base (Titan Text Embeddings V2).
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSION=1024
EMBEDDING_DISTANCE_METRIC=cosine
