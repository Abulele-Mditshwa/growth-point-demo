# Streamlit Community Cloud secrets template.
#
# Paste the contents below into your app's Settings -> Secrets box on
# https://share.streamlit.io (do NOT commit the real values; the live
# secrets.toml is gitignored).
#
# Community Cloud runs the app on Streamlit's servers, so it needs explicit AWS
# credentials (there is no local profile). Use a scoped IAM user/role in the
# abulele-ntt-sandbox account that is allowed only the Bedrock + S3 Vectors
# actions this app needs.

USE_MOCK = "false"
AWS_REGION = "us-east-1"
KNOWLEDGE_BASE_ID = "RG1JAFJZZX"
LLM_MODEL_ID = "us.anthropic.claude-haiku-4-5-20251001-v1:0"

# AWS credentials (access keys for a scoped IAM user). Required because there is
# no named profile on Community Cloud. Do NOT use your root or admin keys.
AWS_ACCESS_KEY_ID = "AKIA..."
AWS_SECRET_ACCESS_KEY = "..."
# AWS_SESSION_TOKEN = "..."   # only if using temporary credentials
